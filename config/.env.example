# Copy to .env (git-ignored) to override config/pipeline.yaml per environment.
# Never commit real credentials.
DISPATCH_API_URL=http://127.0.0.1:8000
# DISPATCH_API_TOKEN=<secret — not needed for the classroom mock>
PAGE_SIZE=100
MAX_RETRIES=4
RETRY_BASE_SECONDS=1
MAX_DATA_AGE_DAYS=45
START_MOCK_API=true
OUTPUT_DIR=data
LOG_LEVEL=INFO
